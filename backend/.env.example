# AI Market Intelligence Backend Configuration Example

# -------------------------------------------------------------
# 1. Core Market Data API Keys
# -------------------------------------------------------------
FINNHUB_API_KEY=your_finnhub_api_key_here
FRED_API_KEY=your_fred_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# 2. MetaTrader 5 DOM Configuration (Local Broker Terminal)
# -------------------------------------------------------------
# To use MT5 for live Level 2 Depth of Market:
# 1. Install MetaTrader 5 from your broker (e.g., IC Markets, Pepperstone, Exness, FTMO).
# 2. Login to your MT5 desktop terminal.
# 3. Set MT5_ENABLED=true below.
MT5_ENABLED=false
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server

# -------------------------------------------------------------
# 3. Spotware cTrader Open API (Cloud Broker Depth Stream)
# -------------------------------------------------------------
# To use cTrader Open API:
# 1. Go to https://openapi.ctrader.com/
# 2. Create an App to get Client ID & Secret.
# 3. Authorize your trading account to generate an Access Token.
# 4. Set CTRADER_ENABLED=true below.
CTRADER_ENABLED=false
CTRADER_CLIENT_ID=your_ctrader_client_id
CTRADER_CLIENT_SECRET=your_ctrader_client_secret
CTRADER_ACCESS_TOKEN=your_ctrader_access_token
CTRADER_ACCOUNT_ID=1234567

# -------------------------------------------------------------
# Server Settings
# -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
